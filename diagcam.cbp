<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="diagcam" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="./bin/Debug/diagcam" prefix_auto="1" extension_auto="1" />
				<Option object_output="./object/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="../v4l2misc" />
					<Add directory="../kbhit" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="./bin/Release/diagcam" prefix_auto="1" extension_auto="1" />
				<Option object_output="./object/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="../v4l2misc" />
					<Add directory="../kbhit" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Linker>
		</Linker>
		<Unit filename="../kbhit/kbhit.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../kbhit/kbhit.h" />
		<Unit filename="../v4l2misc/v4l2core.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../v4l2misc/v4l2core.h" />
		<Unit filename="../v4l2misc/v4l2ctl.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../v4l2misc/v4l2ctl.h" />
		<Unit filename="../v4l2misc/v4l2enum.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../v4l2misc/v4l2enum.h" />
		<Unit filename="diagcam.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
